{
  "outputDirectory": "landing",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/ir/formulario.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(plataforma|solicitar|operacional|ativacao).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, private"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'"
        }
      ]
    }
  ],
  "functions": {
    "api/plataforma.mjs": {
      "includeFiles": "{server/platform/**,docs/etapa-3-preparacao/MODELO-PRECIFICACAO.json,docs/etapa-2-final/MATRIZ-CONSOLIDADA.json}",
      "maxDuration": 30
    },
    "api/operacional.mjs": {
      "includeFiles": "server/platform/**",
      "maxDuration": 30
    },
    "api/operacional-bootstrap.mjs": {
      "includeFiles": "server/platform/**",
      "maxDuration": 30
    }
  },
  "regions": [
    "gru1"
  ]
}
