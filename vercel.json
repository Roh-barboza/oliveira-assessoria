{
  "outputDirectory": "landing",
  "functions": {
    "api/contratacao.mjs": { "maxDuration": 60 }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    {
      "src": "/ir/formulario\\.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0",
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "/contratacao\\.html",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow",
        "Referrer-Policy": "no-referrer",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' https://cdn-public-library.clicksign.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; frame-src https://sandbox.clicksign.com; connect-src 'self' https://sandbox.clicksign.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/api(?:/.*)?", "status": 404 },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
