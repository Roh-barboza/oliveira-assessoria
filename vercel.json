{
  "buildCommand": "node scripts/build-public-release.mjs",
  "outputDirectory": "public-release",
  "framework": null,
  "redirects": [
    {
      "source": "/api/:path*",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/operacional.html",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/equipe.html",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/ativacao.html",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/contratos.html",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/plataforma.html",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/solicitar.html",
      "destination": "/404.html",
      "permanent": false
    },
    {
      "source": "/ir/:path*",
      "destination": "/404.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
